/* forandroidview */

header {
    text-align: center;
    background-color: red;
    margin: 0;
    width: 100%;
    
}

header h1 {
    margin: 0;
    padding: 2px;
    border-radius: 10px;
    border: 2px solid black;
    display: inline-block;
    margin: 10px auto;
}

.banner img {
    width: 100%;
}


.banner .welcome {
    background-color: red;
    margin: 0 auto;
    text-align: center;
}

.banner .welcome h2 {
    margin: 0 auto;
    padding: 10px;
}

.banner .welcome br {
    display: none;
}

.nav1 {
    background-color: aqua;
    position: sticky;
    top: 0;
}

.nav1 ul li {
    display: block;
    border: 1px solid black;
    font-size: 20px;
    padding: 5px;
    padding-left: 10px ;
}

.nav1 ul li a {
    text-decoration: none;
}

.nav1 ul {
    padding-left: 0 ;
    margin: 0 auto;
}


